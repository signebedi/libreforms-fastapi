{% extends "base.html.jinja" %}

{% block title %}
{{config.SITE_NAME}} — Home
{% endblock %}

{% block header %}
<link href="{{ url_for('static', path='css/datatables.css') }}" rel="stylesheet">
{% endblock %}


{% block content %}
<div class="container table-responsive">

{{ render_markdown_content(config['HOMEPAGE_MESSAGE']) | safe }}


{% if config['RECENT_ACTIVITY_ENABLED'] and request.user.is_authenticated %}

    <section aria-labelledby="recentActivityHeading">

    <h2 class="h4" id="recentActivityHeading" style="padding-top: 20px;">Recent Activity</h2>

    {# Live region: announces loading, loaded and empty states to screen readers #}
    <div id="recentActivityStatus" role="status" aria-live="polite">
        <div class="spinner-border spinner-border-sm loading-circle" aria-hidden="true"></div>
        <span id="recentActivityStatusText" class="visually-hidden">Loading recent activity</span>
        <div id="noDataMessage" style="display: none;">There is no recent activity to display</div>
    </div>
    <table id="readAllTable" class="table table-hover table-striped table-light" style="display: none;">
        <caption class="visually-hidden">The most recently created or modified form submissions, newest first</caption>
        <thead>
            <tr>
                <th scope="col">Record</th>
                <th scope="col">Form</th>
                <th scope="col">Last Editor</th>
                <th scope="col">Last Modified</th>
                <th scope="col">Created By</th>
                <th scope="col">Created At</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>

    </section>

{% endif %}
</div>



{% endblock %}

{% block scripts %}

{% if config['RECENT_ACTIVITY_ENABLED'] and request.user.is_authenticated %}
<script src="{{url_for('static', path='js/datatables.js')}}"></script>
<script>
$(document).ready(function () {

    const spinner = document.querySelector('.loading-circle');
    const statusText = document.getElementById('recentActivityStatusText');
    const readAllTable = document.getElementById('readAllTable');
    const noDataMessage = document.getElementById('noDataMessage');
    const apiKey = "{{ request.user.api_key }}";
    const formNames = {{ form_names | tojson }};
    // When other users' profiles are not viewable, render last editor / created by
    // as plain text: a link disabled only with pointer-events stays keyboard-operable
    const profileLinksEnabled = {{ 'true' if config['OTHER_PROFILES_ENABLED'] or request.user.site_admin else 'false' }};
    // Max number of records to show; we only ask each form for its most recently modified
    // records, and without the journal, so large collections don't slow down the homepage
    const recentActivityLength = 25;
    let allFormData = [];


    // Wrap the AJAX call in a function that returns a Promise
    function fetchData(formName) {
        return new Promise((resolve, reject) => {
            $.ajax({
                url: `/api/form/read_all/${formName}?sort_by=__metadata__last_modified&sort_method=descending&set_length=${recentActivityLength}&exclude_journal=true&return_when_empty=true`,
                type: "GET",
                dataType: 'json',
                beforeSend: function(xhr){xhr.setRequestHeader('X-API-KEY', apiKey);},
                success: function(formData) {
                    resolve(formData.documents);
                },
                error: function(xhr, status, error) {
                    reject(error);
                }
            });
        });
    }

    // Create an array of promises
    let promises = formNames.map(formName => fetchData(formName));

    // Use Promise.all to process data after all AJAX calls are complete
    Promise.all(promises).then(results => {
        results.forEach(documents => {
            allFormData = allFormData.concat(documents);
        });

        // Keep only the most recently modified records across all forms
        allFormData.sort((a, b) => new Date(b['metadata']['last_modified']) - new Date(a['metadata']['last_modified']));
        allFormData = allFormData.slice(0, recentActivityLength);

        // Render a user badge: a profile link when profiles are viewable, plain text otherwise
        function renderUserBadge(username) {
            if (profileLinksEnabled) {
                return `<a target="_blank" rel="noopener" href="/ui/auth/p/${username}" class="badge bg-primary text-decoration-none">${username}<span class="visually-hidden"> (profile opens in a new tab)</span></a>`;
            }
            return `<span class="badge bg-primary">${username}</span>`;
        }

        // Render a prettified timestamp; the datetime attribute keeps the machine-readable
        // value, which the DataTables sort below also relies on
        function renderTimestamp(timestamp) {
            return `<time datetime="${timestamp}" title="${timestamp}">${prettifyTimeDiff(timestamp, "{{config['TIMEZONE']|string}}")}</time>`;
        }

        // Now process allFormData
        allFormData.forEach(form => {
            let row = `<tr>
                            <td><a href="/ui/form/read_one/${form['metadata']['form_name']}/${form['metadata']['document_id']}">${form['metadata']['document_id']}</a></td>
                            <td>${form['metadata']['form_name'].replace(/_/g, ' ')}</td>
                            <td>${renderUserBadge(form['metadata']['last_editor'])}</td>
                            <td>${renderTimestamp(form['metadata']['last_modified'])}</td>
                            <td>${renderUserBadge(form['metadata']['created_by'])}</td>
                            <td>${renderTimestamp(form['metadata']['created_at'])}</td>
                        </tr>`;
            $("#readAllTable tbody").append(row);
        });



        spinner.style.display = 'none'; // Hide the spinner
        statusText.textContent = allFormData.length
            ? `Recent activity loaded: ${allFormData.length} records.`
            : 'There is no recent activity to display';
        readAllTable.style.display = ''; // Show the table


        $('#readAllTable').DataTable({
            ordering: true,
            // Set column widths below 
            columns: [{ width: '20%' }, { width: '30%' }, { width: '10%' }, { width: '15%' }, { width: '10%' }, { width: '15%' }],
            pageLength: 5,
            lengthChange: false,
            info: false,
            // paging: false,
            searching: false,
            order: [[3, 'desc']],
            // This is a fix to properly sort prettified datetimes
            columnDefs: [
                {
                    targets: [3, 5],
                    render: function(data, type, row) {
                        var date = $(data).attr('datetime');
                        return type === 'sort' ? date : data;
                    }
                }
            ]
        });

    }).catch(error => {
        console.error("Error fetching data:", error);
        // flashMessage("There was an issue fetching results. There may be none to display.", AlertCategories.WARNING);
        spinner.style.display = 'none'; // Hide the spinner
        statusText.textContent = ''; // The visible message below is announced instead
        readAllTable.style.display = 'none';
        noDataMessage.style.display = '';

    });
});
</script>



{% endif %}

{% endblock %}
